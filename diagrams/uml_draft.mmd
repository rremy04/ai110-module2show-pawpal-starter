classDiagram
    %% PawPal+ draft design: Owner, Pet, Task, Scheduler

    class Owner {
        +String name
        +int available_minutes_per_day
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +int age
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() List~Task~
    }

    class Task {
        +String title
        +String category
        +int duration_minutes
        +Priority priority
        +String pet_name
        +String preferred_time
        +bool completed
        +mark_complete() void
    }

    class Scheduler {
        +Owner owner
        +List~Task~ plan
        +List~Task~ skipped
        +build_daily_plan() List~Task~
        +explain_plan() String
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    Task --> Priority : has
    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : orders and selects
